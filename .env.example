# Copy to .env.local for local dev (never commit .env.local — it's gitignored).
# In production, set these in Vercel: Project Settings -> Environment Variables.

# Web3Forms access key (contact/order/wholesale forms). Get a free key at
# web3forms.com. Must be NEXT_PUBLIC_-prefixed — WebForm.jsx is a client
# component and needs this value in the browser bundle. Web3Forms keys are
# public-by-design; this is deploy hygiene (rotate/vary per environment),
# not a secret.
NEXT_PUBLIC_WEB3FORMS_KEY=
