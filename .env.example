# Copy to .env.local for local dev (never commit .env.local — it's gitignored).
# In production, set these in Vercel: Project Settings -> Environment Variables.

# Web3Forms access key (contact/wholesale forms only — the Order System
# below has its own SMTP-based sender, see "Order System" section).
# Get a free key at web3forms.com. Must be NEXT_PUBLIC_-prefixed — WebForm.jsx
# is a client component and needs this value in the browser bundle. Web3Forms
# keys are public-by-design; this is deploy hygiene (rotate/vary per
# environment), not a secret.
NEXT_PUBLIC_WEB3FORMS_KEY=

# ============================================================
# Order System (Intake Section P) — real secrets, never NEXT_PUBLIC_.
# ============================================================

# SMTP for order-confirmation / invoice emails. Umbra Electric's mailbox is
# on Zoho Mail (free plan): host is smtp.zoho.com. If the plan is ever
# upgraded to paid, the host changes to smtppro.zoho.com — using the wrong
# one fails at AUTH with "554 5.7.8 Access Restricted", which looks exactly
# like a bad password. SMTP_PASS is a Zoho Application-Specific Password
# (Zoho Accounts -> Security -> App Passwords), not the mailbox login password.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@umbraelectric.com
SMTP_PASS=

# Where new-order / settlement-terminal notifications are sent (the "sales
# desk" inbox). Separate from SMTP_USER (the sending mailbox).
ORDER_NOTIFY_EMAIL=acecarts01@gmail.com

# HMAC secret for signed order tokens and the admin session cookie. >=16
# chars, generate once, never reuse elsewhere, never commit the real value.
ORDER_SIGNING_SECRET=

# Single admin passphrase for /admin/portal/ (no user table, no session
# store -- matches the scale of a single sales-desk login).
ADMIN_PASSPHRASE=

# Postgres connection string for the admin portal's order/enquiry mirror.
# Set automatically when a Neon database is connected via Vercel's Storage
# tab (Project -> Storage -> Create Database -> Neon). Pull it locally with:
#   vercel env pull --environment=development .env.local
DATABASE_URL=

# Only needed if the canonical domain in src/data/site.json shouldn't be
# used for email links in this environment (Preview already auto-resolves
# to its own *.vercel.app URL via VERCEL_URL — see src/lib/order/siteUrl.js).
# NEXT_PUBLIC_SITE_URL=
